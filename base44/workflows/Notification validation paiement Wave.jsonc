{
  "name": "Notification validation paiement Wave",
  "description": "Notifie l'acheteur par email + in-app quand le statut de son paiement Wave change (valid\u00e9 \u2192 contenu d\u00e9bloqu\u00e9 / refus\u00e9)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WavePayment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_validation_paiement_wave",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPaymentStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}