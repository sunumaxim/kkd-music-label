{
  "name": "Notification validation \u00e9v\u00e9nement",
  "description": "Notifie l'organisateur (partenaire) par email + in-app quand le statut de validation de son \u00e9v\u00e9nement change (approuv\u00e9 / refus\u00e9)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_validation_v_nement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyEventStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}