{
  "name": "Notification changement statut publication partenaire",
  "description": "Notifie le partenaire par email (+ in-app) quand le statut de sa publication change (approuv\u00e9, publi\u00e9, refus\u00e9)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PartnerPublication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_changement_statut_publication_partenaire",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPublicationStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}