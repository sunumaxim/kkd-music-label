{
  "name": "Facebook \u2014 Nouvel \u00c9v\u00e9nement",
  "description": "Publie automatiquement les nouveaux \u00e9v\u00e9nements sur les Pages Facebook g\u00e9r\u00e9es par le compte connect\u00e9.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "facebook_nouvel_v_nement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publishToFacebook",
            "args": {
              "content_type": "event"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}