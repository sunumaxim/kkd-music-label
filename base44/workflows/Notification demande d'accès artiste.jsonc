{
  "name": "Notification demande d'acc\u00e8s artiste",
  "description": "Notifie l'utilisateur par email + in-app quand sa demande d'acc\u00e8s \u00e0 un profil artiste est approuv\u00e9e ou refus\u00e9e",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ArtistAccessRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_demande_d_acc_s_artiste",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAccessRequestStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}