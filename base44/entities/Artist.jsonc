{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'artiste"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo principale de l'artiste"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galerie de photos (URLs)"
    },
    "biography": {
      "type": "string",
      "description": "Biographie de l'artiste"
    },
    "genre": {
      "type": "string",
      "description": "Genre musical"
    },
    "label": {
      "type": "string",
      "description": "Label de l'artiste"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Date de naissance"
    },
    "birth_place": {
      "type": "string",
      "description": "Lieu de naissance"
    },
    "nationality": {
      "type": "string",
      "description": "Nationalit\u00e9"
    },
    "active_since": {
      "type": "string",
      "description": "Ann\u00e9e de d\u00e9but d'activit\u00e9"
    },
    "group_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Membres du groupe"
    },
    "associated_acts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Artistes associ\u00e9s"
    },
    "wikipedia_url": {
      "type": "string",
      "description": "Lien Wikipedia"
    },
    "website_url": {
      "type": "string",
      "description": "Site officiel"
    },
    "spotify_url": {
      "type": "string",
      "description": "Lien Spotify"
    },
    "youtube_url": {
      "type": "string",
      "description": "Lien YouTube"
    },
    "apple_music_url": {
      "type": "string",
      "description": "Lien Apple Music"
    },
    "audiomack_url": {
      "type": "string",
      "description": "Lien Audiomack"
    },
    "deezer_url": {
      "type": "string",
      "description": "Lien Deezer"
    },
    "soundcloud_url": {
      "type": "string",
      "description": "Lien SoundCloud"
    },
    "instagram_url": {
      "type": "string",
      "description": "Lien Instagram"
    },
    "instagram_username": {
      "type": "string",
      "description": "Nom d'utilisateur Instagram (sans @)"
    },
    "tiktok_url": {
      "type": "string",
      "description": "Lien TikTok"
    },
    "tiktok_username": {
      "type": "string",
      "description": "Nom d'utilisateur TikTok (sans @)"
    },
    "facebook_url": {
      "type": "string",
      "description": "Lien Facebook"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Artiste mis en avant"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    }
  },
  "required": [
    "name"
  ]
}