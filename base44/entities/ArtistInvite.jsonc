{
  "name": "ArtistInvite",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string",
      "description": "ID de l'artiste li\u00e9 (depuis l'entit\u00e9 Artist)"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste"
    },
    "email": {
      "type": "string",
      "description": "Email de l'artiste invit\u00e9"
    },
    "invite_type": {
      "type": "string",
      "enum": [
        "artiste_kkd",
        "label_partenaire"
      ],
      "default": "artiste_kkd",
      "description": "Type d'invitation"
    },
    "label_name": {
      "type": "string",
      "description": "Nom du label auquel appartient cet artiste"
    },
    "label_id": {
      "type": "string",
      "description": "ID de l'invite label (si artiste rattach\u00e9 \u00e0 un label)"
    },
    "contract_start": {
      "type": "string",
      "format": "date",
      "description": "D\u00e9but du contrat"
    },
    "contract_end": {
      "type": "string",
      "format": "date",
      "description": "Fin du contrat"
    },
    "status": {
      "type": "string",
      "enum": [
        "invite",
        "actif",
        "expire",
        "resilie"
      ],
      "default": "invite",
      "description": "Statut du contrat"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Contrat certifi\u00e9 \u2014 badge bleu pour artiste, badge dor\u00e9 pour label"
    },
    "notes": {
      "type": "string",
      "description": "Notes sur l'invitation / contrat"
    }
  },
  "required": [
    "artist_name",
    "email",
    "invite_type"
  ]
}