{
  "name": "Release",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la sortie"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL propre (ex : /musique/mon-titre) \u2014 auto-g\u00e9n\u00e9r\u00e9 depuis le titre"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste"
    },
    "artist_id": {
      "type": "string",
      "description": "Artiste li\u00e9 du catalogue (obligatoire \u00e0 la cr\u00e9ation/\u00e9dition)"
    },
    "cover_url": {
      "type": "string",
      "description": "Pochette (obligatoire \u00e0 la publication)"
    },
    "release_type": {
      "type": "string",
      "enum": [
        "single",
        "album",
        "ep",
        "projet_special"
      ],
      "default": "single",
      "description": "Type de sortie"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Date de sortie"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "spotify_url": {
      "type": "string",
      "description": "Lien Spotify"
    },
    "youtube_url": {
      "type": "string",
      "description": "Lien YouTube"
    },
    "apple_music_url": {
      "type": "string",
      "description": "Lien Apple Music"
    },
    "audiomack_url": {
      "type": "string",
      "description": "Lien Audiomack"
    },
    "deezer_url": {
      "type": "string",
      "description": "Lien Deezer"
    },
    "audio_file_url": {
      "type": "string",
      "description": "Fichier audio (single gratuit) h\u00e9berg\u00e9 sur KKD pour lecture int\u00e9gr\u00e9e continue"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Titre de la piste"
          },
          "audio_file_url": {
            "type": "string",
            "description": "Fichier audio de la piste"
          }
        }
      },
      "description": "Liste des pistes (album / EP) \u2014 chaque piste a son fichier audio"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant sur la page d'accueil"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Mettre en vente sur KKD (single/clip payant)"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Prix de vente en euros (0 = non vendu)"
    },
    "protected_file_uri": {
      "type": "string",
      "description": "Fichier vendu (audio/vid\u00e9o priv\u00e9) \u2014 accessible uniquement apr\u00e8s achat via lien sign\u00e9"
    },
    "preview_start": {
      "type": "number",
      "default": 0,
      "description": "D\u00e9but de l'extrait d'\u00e9coute gratuit de 30s (secondes)"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de likes"
    },
    "plays_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'\u00e9coutes sur KKD"
    },
    "sales_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'achats / pr\u00e9commandes"
    },
    "lyrics": {
      "type": "string",
      "description": "Paroles du titre"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    }
  },
  "required": [
    "title",
    "artist_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}