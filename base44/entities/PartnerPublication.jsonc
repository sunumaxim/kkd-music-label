{
  "name": "PartnerPublication",
  "type": "object",
  "properties": {
    "partner_email": {
      "type": "string",
      "description": "Email du partenaire qui publie"
    },
    "partner_name": {
      "type": "string",
      "description": "Nom du partenaire / artiste"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "sortie_musicale",
        "video_clip",
        "album",
        "ep",
        "playlist",
        "autre"
      ],
      "default": "sortie_musicale",
      "description": "Type de contenu"
    },
    "title": {
      "type": "string",
      "description": "Titre de la publication"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste"
    },
    "artist_id": {
      "type": "string",
      "description": "ID de l'artiste existant li\u00e9 (si s\u00e9lectionn\u00e9)"
    },
    "new_artist_genre": {
      "type": "string",
      "description": "Genre du nouveau profil artiste (si cr\u00e9ation \u00e0 la publication)"
    },
    "new_artist_photo_url": {
      "type": "string",
      "description": "Photo du nouveau profil artiste (si cr\u00e9ation \u00e0 la publication)"
    },
    "streaming_link": {
      "type": "string",
      "description": "Lien principal de streaming (facultatif)"
    },
    "streaming_platform": {
      "type": "string",
      "enum": [
        "spotify",
        "apple_music",
        "youtube",
        "audiomack",
        "amazon_music",
        "deezer",
        "soundcloud",
        "autre"
      ],
      "default": "spotify",
      "description": "Plateforme de streaming"
    },
    "secondary_link": {
      "type": "string",
      "description": "Lien secondaire (autre plateforme)"
    },
    "instagram_link": {
      "type": "string",
      "description": "Lien post ou compte Instagram associ\u00e9"
    },
    "cover_url": {
      "type": "string",
      "description": "Pochette / miniature (optionnel)"
    },
    "file_url": {
      "type": "string",
      "description": "Fichier audio/vid\u00e9o t\u00e9l\u00e9vers\u00e9 (contenu principal). Public si gratuit, priv\u00e9 (file_uri) si payant."
    },
    "description": {
      "type": "string",
      "description": "Description / message pour l'\u00e9quipe KKD"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Contenu payant (vente exclusive KKD)"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Prix de vente en euros (0 = non vendu)"
    },
    "preview_start": {
      "type": "number",
      "default": 0,
      "description": "D\u00e9but de l'extrait d'\u00e9coute gratuit de 30s (secondes)"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "approuve",
        "publie",
        "refuse"
      ],
      "default": "en_attente",
      "description": "Statut de validation par l'admin"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes de l'\u00e9quipe KKD"
    },
    "published_as_release_id": {
      "type": "string",
      "description": "ID de la sortie/vid\u00e9o cr\u00e9\u00e9e apr\u00e8s publication admin"
    }
  },
  "required": [
    "partner_email",
    "title",
    "content_type"
  ]
}