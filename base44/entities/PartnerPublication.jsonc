{
  "name": "PartnerPublication",
  "type": "object",
  "properties": {
    "partner_email": {
      "type": "string",
      "description": "Email du partenaire qui publie"
    },
    "partner_name": {
      "type": "string",
      "description": "Nom du partenaire / artiste"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "sortie_musicale",
        "video_clip",
        "album",
        "ep",
        "playlist",
        "autre"
      ],
      "default": "sortie_musicale",
      "description": "Type de contenu"
    },
    "title": {
      "type": "string",
      "description": "Titre de la publication"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste principal"
    },
    "artist_id": {
      "type": "string",
      "description": "ID de l'artiste existant li\u00e9 (si s\u00e9lectionn\u00e9)"
    },
    "featuring_artist": {
      "type": "string",
      "description": "Nom de l'artiste en featuring / collaboration (optionnel)"
    },
    "featuring_artist_id": {
      "type": "string",
      "description": "ID de l'artiste en featuring (si s\u00e9lectionn\u00e9 dans le catalogue)"
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "producteur",
              "realisateur",
              "auteur",
              "compositeur",
              "mixage",
              "mastering",
              "arrangements",
              "autre"
            ],
            "description": "R\u00f4le / fonction"
          },
          "name": {
            "type": "string",
            "description": "Nom de la personne cr\u00e9dit\u00e9e"
          }
        },
        "required": [
          "role",
          "name"
        ]
      },
      "default": [],
      "description": "Cr\u00e9dits (producteur, r\u00e9alisateur, auteur, compositeur, etc.)"
    },
    "new_artist_genre": {
      "type": "string",
      "description": "Genre du nouveau profil artiste (si cr\u00e9ation \u00e0 la publication)"
    },
    "new_artist_photo_url": {
      "type": "string",
      "description": "Photo du nouveau profil artiste (si cr\u00e9ation \u00e0 la publication)"
    },
    "streaming_link": {
      "type": "string",
      "description": "Lien principal de streaming (facultatif)"
    },
    "streaming_platform": {
      "type": "string",
      "enum": [
        "spotify",
        "apple_music",
        "youtube",
        "audiomack",
        "amazon_music",
        "deezer",
        "soundcloud",
        "autre"
      ],
      "default": "spotify",
      "description": "Plateforme de streaming"
    },
    "secondary_link": {
      "type": "string",
      "description": "Lien secondaire (autre plateforme)"
    },
    "instagram_link": {
      "type": "string",
      "description": "Lien post ou compte Instagram associ\u00e9"
    },
    "cover_url": {
      "type": "string",
      "description": "Pochette / miniature (obligatoire)"
    },
    "file_url": {
      "type": "string",
      "description": "Fichier audio/vid\u00e9o principal (single/clip). Public si gratuit, priv\u00e9 (file_uri) si payant."
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Titre de la piste"
          },
          "audio_file_url": {
            "type": "string",
            "description": "Fichier audio de la piste (upload KKD)"
          },
          "streaming_link": {
            "type": "string",
            "description": "Lien streaming externe de la piste (Spotify, YouTube, Deezer, etc.) si import\u00e9 depuis une plateforme"
          },
          "streaming_platform": {
            "type": "string",
            "description": "Plateforme d'origine de la piste (spotify, deezer, youtube, audiomack, etc.)"
          },
          "duration_ms": {
            "type": "number",
            "description": "Dur\u00e9e de la piste en millisecondes (si import\u00e9e)"
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "Pistes d'un album / EP (fichier audio KKD ou lien streaming externe import\u00e9)"
    },
    "description": {
      "type": "string",
      "description": "Description / message pour l'\u00e9quipe KKD"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Contenu payant (single payant)"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Prix de vente en FCFA (0 = non vendu)"
    },
    "preview_start": {
      "type": "number",
      "default": 0,
      "description": "D\u00e9but de l'extrait d'\u00e9coute gratuit (secondes)"
    },
    "preview_duration": {
      "type": "number",
      "default": 30,
      "description": "Dur\u00e9e de l'extrait gratuit en secondes (25 ou 30, choisi par l'uploadeur)"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "approuve",
        "publie",
        "refuse"
      ],
      "default": "en_attente",
      "description": "Statut de validation par l'admin"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes de l'\u00e9quipe KKD"
    },
    "published_as_release_id": {
      "type": "string",
      "description": "ID de la sortie/vid\u00e9o cr\u00e9\u00e9e apr\u00e8s publication admin"
    }
  },
  "required": [
    "partner_email",
    "title",
    "content_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}