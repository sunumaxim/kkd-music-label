{
  "name": "PromoBanner",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la promotion / annonce"
    },
    "type": {
      "type": "string",
      "enum": [
        "banner",
        "audio"
      ],
      "default": "banner",
      "description": "Banni\u00e8re image (cliquable/embed) ou annonce audio KKD"
    },
    "sponsor_name": {
      "type": "string",
      "description": "Nom du sponsor (ou 'KKD Music' pour une annonce interne)"
    },
    "image_url": {
      "type": "string",
      "description": "Image de la banni\u00e8re"
    },
    "audio_url": {
      "type": "string",
      "description": "Fichier audio de l'annonce (type audio)"
    },
    "link_url": {
      "type": "string",
      "description": "Lien externe ouvert au clic (site internet sponsor)"
    },
    "embed_url": {
      "type": "string",
      "description": "URL \u00e0 afficher directement en iframe (site externe / habillage)"
    },
    "text": {
      "type": "string",
      "description": "Texte / slogan affich\u00e9 sur la banni\u00e8re"
    },
    "placement": {
      "type": "string",
      "enum": [
        "top_banner",
        "feed",
        "player"
      ],
      "default": "top_banner",
      "description": "Emplacement d'affichage"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Actif"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "D\u00e9but de diffusion"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fin de diffusion"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    },
    "clicks_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de clics"
    },
    "impressions_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'impressions"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}