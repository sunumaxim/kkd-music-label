{
  "name": "MusicLicense",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string",
      "description": "ID de l'artiste li\u00e9"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste (d\u00e9norm\u00e9)"
    },
    "release_id": {
      "type": "string",
      "description": "ID de la sortie li\u00e9e (si licence sp\u00e9cifique \u00e0 une sortie)"
    },
    "release_title": {
      "type": "string",
      "description": "Titre de la sortie (d\u00e9norm\u00e9)"
    },
    "video_id": {
      "type": "string",
      "description": "ID de la vid\u00e9o li\u00e9e (si licence sp\u00e9cifique \u00e0 un clip)"
    },
    "video_title": {
      "type": "string",
      "description": "Titre de la vid\u00e9o (d\u00e9norm\u00e9)"
    },
    "license_type": {
      "type": "string",
      "enum": [
        "distribution",
        "authenticite",
        "double"
      ],
      "default": "double",
      "description": "Type de licence"
    },
    "license_number": {
      "type": "string",
      "description": "Num\u00e9ro unique de licence (KKD-LIC-YYYYMMDD-XXXX)"
    },
    "certificate_number": {
      "type": "string",
      "description": "Num\u00e9ro unique de certificat (KKD-CERT-YYYYMMDD-XXXX)"
    },
    "pdf_data": {
      "type": "object",
      "description": "Donn\u00e9es compl\u00e8tes pour r\u00e9g\u00e9n\u00e9rer les PDF c\u00f4t\u00e9 frontend",
      "properties": {
        "isrc": {
          "type": "string"
        },
        "artist_genre": {
          "type": "string"
        },
        "artist_verified": {
          "type": "boolean"
        },
        "artist_nationality": {
          "type": "string"
        },
        "label_name": {
          "type": "string"
        },
        "work_title": {
          "type": "string"
        },
        "work_type": {
          "type": "string"
        },
        "work_date": {
          "type": "string"
        },
        "streaming_url": {
          "type": "string"
        }
      },
      "default": {}
    },
    "document_url": {
      "type": "string",
      "description": "URL du document PDF (licence de distribution) \u2014 si upload\u00e9"
    },
    "certificate_url": {
      "type": "string",
      "description": "URL du certificat PDF \u2014 si upload\u00e9"
    },
    "originality_hash": {
      "type": "string",
      "description": "Empreinte d'originalit\u00e9 (hash SHA-256)"
    },
    "originality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "conforme",
              "attention",
              "non_verifie"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Contr\u00f4les d'originalit\u00e9 effectu\u00e9s"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "genere",
        "envoye",
        "expire",
        "refuse"
      ],
      "default": "en_attente",
      "description": "Statut de la demande"
    },
    "requested_by_email": {
      "type": "string",
      "description": "Email du demandeur"
    },
    "sent_to_email": {
      "type": "string",
      "description": "Email destinataire"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'envoi par email"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Date de validit\u00e9"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes admin"
    },
    "description": {
      "type": "string",
      "description": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "artist_name",
    "license_type",
    "requested_by_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_by_email": "{{user.email}}"
        },
        {
          "data.sent_to_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}