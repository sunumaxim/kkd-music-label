{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'événement"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL propre (ex : /evenements/mon-evenement) — auto-généré depuis le titre"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "image_url": {
      "type": "string",
      "description": "Affiche / image de l'événement"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "concert",
        "showcase",
        "festival",
        "rencontre"
      ],
      "default": "concert",
      "description": "Type d'événement"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure"
    },
    "location": {
      "type": "string",
      "description": "Lieu"
    },
    "city": {
      "type": "string",
      "description": "Ville"
    },
    "ticket_url": {
      "type": "string",
      "description": "Lien billetterie externe (si pas de vente KKD)"
    },
    "stream_url": {
      "type": "string",
      "description": "Lien live stream YouTube"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de likes"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    },
    "linked_release_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs des sorties liées à afficher sur la page événement"
    },
    "artist_id": {
      "type": "string",
      "description": "Artiste principal lié (optionnel)"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste lié (dénormalisé)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (partenaire)"
    },
    "organizer_name": {
      "type": "string",
      "description": "Nom de l'organisateur"
    },
    "published_status": {
      "type": "string",
      "enum": [
        "en_attente",
        "approuve",
        "refuse",
        "clarification_demandee"
      ],
      "default": "approuve",
      "description": "Statut de validation (en_attente = soumis par partenaire, approuve = visible, clarification_demandee = infos complémentaires requises)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes admin / message de clarification demandé à l'organisateur"
    },
    "is_ticketed": {
      "type": "boolean",
      "default": false,
      "description": "Vente de billets en ligne via KKD/Wave"
    },
    "ticket_price": {
      "type": "number",
      "default": 0,
      "description": "Prix du billet en FCFA"
    },
    "ticket_capacity": {
      "type": "number",
      "default": 0,
      "description": "Capacité (0 = illimitée)"
    },
    "tickets_sold": {
      "type": "number",
      "default": 0,
      "description": "Billets vendus (validés)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Emails autorisés à gérer le contrôle d'accès"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) sur les ventes de billets"
    },
    "ticket_theme": {
      "type": "string",
      "enum": [
        "classic",
        "gold",
        "emerald",
        "royal",
        "ocean",
        "midnight",
        "poster",
        "minimal"
      ],
      "default": "classic",
      "description": "Thème de design des billets (classic=rouge/noir, gold=or/noir, emerald=vert/noir, royal=violet/noir, ocean=bleu/noir)"
    },
    "ticket_categories": {
      "type": "array",
      "default": [],
      "description": "Catégories de billets (ex: Prévente en ligne, Porte). channel = online (vente sur la plateforme) ou door (guichet sur place)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "description": "Prix en FCFA"
          },
          "channel": {
            "type": "string",
            "enum": [
              "online",
              "door"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "online_sales_end": {
      "type": "string",
      "format": "date-time",
      "description": "Fin de la vente en ligne (par défaut : début de l événement)"
    },
    "landing_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Page concert dédiée disponible sur /concert/<slug>"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude GPS du lieu"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude GPS du lieu"
    },
    "location_address": {
      "type": "string",
      "description": "Adresse complète du lieu (issue de la recherche de lieu)"
    },
    "sponsors": {
      "type": "array",
      "default": [],
      "description": "Sponsors de l'événement",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "link_url": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "principal",
              "sponsor",
              "media"
            ]
          }
        }
      }
    }
  },
  "required": [
    "title",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}