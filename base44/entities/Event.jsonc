{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL propre (ex : /evenements/mon-evenement) \u2014 auto-g\u00e9n\u00e9r\u00e9 depuis le titre"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "image_url": {
      "type": "string",
      "description": "Affiche / image de l'\u00e9v\u00e9nement"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "concert",
        "showcase",
        "festival",
        "rencontre"
      ],
      "default": "concert",
      "description": "Type d'\u00e9v\u00e9nement"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure"
    },
    "location": {
      "type": "string",
      "description": "Lieu"
    },
    "city": {
      "type": "string",
      "description": "Ville"
    },
    "ticket_url": {
      "type": "string",
      "description": "Lien billetterie externe (si pas de vente KKD)"
    },
    "stream_url": {
      "type": "string",
      "description": "Lien live stream YouTube"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de likes"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    },
    "linked_release_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs des sorties li\u00e9es \u00e0 afficher sur la page \u00e9v\u00e9nement"
    },
    "artist_id": {
      "type": "string",
      "description": "Artiste principal li\u00e9 (optionnel)"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste li\u00e9 (d\u00e9normalis\u00e9)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (partenaire)"
    },
    "organizer_name": {
      "type": "string",
      "description": "Nom de l'organisateur"
    },
    "published_status": {
      "type": "string",
      "enum": [
        "en_attente",
        "approuve",
        "refuse",
        "clarification_demandee"
      ],
      "default": "approuve",
      "description": "Statut de validation (en_attente = soumis par partenaire, approuve = visible, clarification_demandee = infos compl\u00e9mentaires requises)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes admin / message de clarification demand\u00e9 \u00e0 l'organisateur"
    },
    "external_ref": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence d'origine externe (ex : showofkkd:<id>) \u2014 permet de suivre un \u00e9v\u00e9nement import\u00e9 d'une plateforme partenaire"
    },
    "is_ticketed": {
      "type": "boolean",
      "default": false,
      "description": "Vente de billets en ligne via KKD/Wave"
    },
    "ticket_price": {
      "type": "number",
      "default": 0,
      "description": "Prix du billet en FCFA"
    },
    "ticket_capacity": {
      "type": "number",
      "default": 0,
      "description": "Capacit\u00e9 (0 = illimit\u00e9e)"
    },
    "tickets_sold": {
      "type": "number",
      "default": 0,
      "description": "Billets vendus (valid\u00e9s)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Emails autoris\u00e9s \u00e0 g\u00e9rer le contr\u00f4le d'acc\u00e8s"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) sur les ventes de billets"
    },
    "ticket_theme": {
      "type": "string",
      "enum": [
        "classic",
        "gold",
        "emerald",
        "royal",
        "ocean",
        "midnight",
        "poster",
        "minimal"
      ],
      "default": "classic",
      "description": "Th\u00e8me de design des billets (classic=rouge/noir, gold=or/noir, emerald=vert/noir, royal=violet/noir, ocean=bleu/noir)"
    },
    "ticket_categories": {
      "type": "array",
      "default": [],
      "description": "Cat\u00e9gories de billets (ex: Pr\u00e9vente en ligne, Porte). channel = online (vente sur la plateforme) ou door (guichet sur place)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "description": "Prix en FCFA"
          },
          "channel": {
            "type": "string",
            "enum": [
              "online",
              "door"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "online_sales_end": {
      "type": "string",
      "format": "date-time",
      "description": "Fin de la vente en ligne (par d\u00e9faut : d\u00e9but de l \u00e9v\u00e9nement)"
    },
    "landing_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Page concert d\u00e9di\u00e9e disponible sur /concert/<slug>"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude GPS du lieu"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude GPS du lieu"
    },
    "location_address": {
      "type": "string",
      "description": "Adresse compl\u00e8te du lieu (issue de la recherche de lieu)"
    },
    "sponsors": {
      "type": "array",
      "default": [],
      "description": "Sponsors de l'\u00e9v\u00e9nement",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "link_url": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "principal",
              "sponsor",
              "media"
            ]
          }
        }
      }
    }
  },
  "required": [
    "title",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}