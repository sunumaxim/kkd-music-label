{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL propre (ex : /evenements/mon-evenement) \u2014 auto-g\u00e9n\u00e9r\u00e9 depuis le titre"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "image_url": {
      "type": "string",
      "description": "Affiche / image de l'\u00e9v\u00e9nement"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "concert",
        "showcase",
        "festival",
        "rencontre"
      ],
      "default": "concert",
      "description": "Type d'\u00e9v\u00e9nement"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure"
    },
    "location": {
      "type": "string",
      "description": "Lieu"
    },
    "city": {
      "type": "string",
      "description": "Ville"
    },
    "ticket_url": {
      "type": "string",
      "description": "Lien billetterie externe (si pas de vente KKD)"
    },
    "stream_url": {
      "type": "string",
      "description": "Lien live stream YouTube"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de likes"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    },
    "linked_release_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs des sorties li\u00e9es \u00e0 afficher sur la page \u00e9v\u00e9nement"
    },
    "artist_id": {
      "type": "string",
      "description": "Artiste principal li\u00e9 (optionnel)"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste li\u00e9 (d\u00e9normalis\u00e9)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (partenaire)"
    },
    "organizer_name": {
      "type": "string",
      "description": "Nom de l'organisateur"
    },
    "published_status": {
      "type": "string",
      "enum": [
        "en_attente",
        "approuve",
        "refuse",
        "clarification_demandee"
      ],
      "default": "approuve",
      "description": "Statut de validation (en_attente = soumis par partenaire, approuve = visible, clarification_demandee = infos compl\u00e9mentaires requises)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes admin / message de clarification demand\u00e9 \u00e0 l'organisateur"
    },
    "is_ticketed": {
      "type": "boolean",
      "default": false,
      "description": "Vente de billets en ligne via KKD/Wave"
    },
    "ticket_price": {
      "type": "number",
      "default": 0,
      "description": "Prix du billet en FCFA"
    },
    "ticket_capacity": {
      "type": "number",
      "default": 0,
      "description": "Capacit\u00e9 (0 = illimit\u00e9e)"
    },
    "tickets_sold": {
      "type": "number",
      "default": 0,
      "description": "Billets vendus (valid\u00e9s)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Emails autoris\u00e9s \u00e0 g\u00e9rer le contr\u00f4le d'acc\u00e8s"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) sur les ventes de billets"
    }
  },
  "required": [
    "title",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}