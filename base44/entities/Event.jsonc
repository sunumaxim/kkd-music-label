{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "image_url": {
      "type": "string",
      "description": "Image de l'\u00e9v\u00e9nement"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "concert",
        "showcase",
        "festival",
        "rencontre"
      ],
      "default": "concert",
      "description": "Type d'\u00e9v\u00e9nement"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure"
    },
    "location": {
      "type": "string",
      "description": "Lieu"
    },
    "city": {
      "type": "string",
      "description": "Ville"
    },
    "ticket_url": {
      "type": "string",
      "description": "Lien billetterie"
    },
    "stream_url": {
      "type": "string",
      "description": "Lien live stream YouTube"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de likes"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    },
    "linked_release_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs des sorties li\u00e9es \u00e0 afficher sur la page \u00e9v\u00e9nement (\u00e9coute int\u00e9gr\u00e9e)"
    }
  },
  "required": [
    "title",
    "event_date"
  ]
}