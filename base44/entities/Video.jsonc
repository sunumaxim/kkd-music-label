{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la vid\u00e9o"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste"
    },
    "youtube_url": {
      "type": "string",
      "description": "Lien YouTube"
    },
    "video_file_url": {
      "type": "string",
      "description": "Fichier vid\u00e9o direct (replay cam\u00e9ra / t\u00e9l\u00e9phone / upload) si pas de lien YouTube"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Miniature"
    },
    "video_type": {
      "type": "string",
      "enum": [
        "clip_officiel",
        "teaser",
        "interview",
        "making_of",
        "replay_live"
      ],
      "default": "clip_officiel",
      "description": "Type de vid\u00e9o"
    },
    "broadcast_id": {
      "type": "string",
      "description": "ID du direct archiv\u00e9 (replay)"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "publish_date": {
      "type": "string",
      "format": "date",
      "description": "Date de publication"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de vues"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      },
      "description": "Commentaires des fans"
    }
  },
  "required": [
    "title",
    "youtube_url"
  ]
}