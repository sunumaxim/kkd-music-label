{
  "name": "CorrespondentInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email du correspondant"
    },
    "name": {
      "type": "string",
      "description": "Nom du correspondant"
    },
    "broadcast_id": {
      "type": "string",
      "description": "Direct li\u00e9 (source du filmage)"
    },
    "event_id": {
      "type": "string",
      "description": "\u00c9v\u00e9nement couvert"
    },
    "event_title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "token": {
      "type": "string",
      "description": "Jeton d'acc\u00e8s au portail correspondant"
    },
    "status": {
      "type": "string",
      "enum": [
        "invite",
        "accepte",
        "filme",
        "termine"
      ],
      "default": "invite",
      "description": "Statut de l'invitation"
    },
    "accepted_date": {
      "type": "string",
      "format": "date-time"
    },
    "capture_url": {
      "type": "string",
      "description": "Derni\u00e8re capture vid\u00e9o envoy\u00e9e"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "email",
    "token",
    "broadcast_id"
  ]
}