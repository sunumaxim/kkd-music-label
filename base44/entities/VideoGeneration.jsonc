{
  "name": "VideoGeneration",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur ayant g\u00e9n\u00e9r\u00e9 la vid\u00e9o"
    },
    "prompt": {
      "type": "string",
      "description": "Action souhait\u00e9e par l'utilisateur (texte libre)"
    },
    "image_url": {
      "type": "string",
      "description": "Image source (file_uri priv\u00e9 upload\u00e9 par l'utilisateur)"
    },
    "image_description": {
      "type": "string",
      "description": "Description visuelle de l'image g\u00e9n\u00e9r\u00e9e par l'IA"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la vid\u00e9o anim\u00e9e g\u00e9n\u00e9r\u00e9e"
    },
    "release_id": {
      "type": "string",
      "description": "ID de la sortie/chanson li\u00e9e \u00e0 la vid\u00e9o (optionnel)"
    },
    "release_title": {
      "type": "string",
      "description": "Titre de la chanson li\u00e9e (d\u00e9normalis\u00e9, optionnel)"
    },
    "artist_name": {
      "type": "string",
      "description": "Nom de l'artiste de la chanson li\u00e9e (d\u00e9normalis\u00e9, optionnel)"
    },
    "audio_file_url": {
      "type": "string",
      "description": "URL du fichier audio public de la chanson li\u00e9e (pour lecture synchronis\u00e9e c\u00f4t\u00e9 frontend)"
    },
    "excerpt_start": {
      "type": "number",
      "default": 0,
      "description": "D\u00e9but de l'extrait audio en secondes"
    },
    "excerpt_duration": {
      "type": "number",
      "default": 6,
      "description": "Dur\u00e9e de l'extrait audio en secondes"
    },
    "quota_date": {
      "type": "string",
      "description": "Date UTC (YYYY-MM-DD) de la g\u00e9n\u00e9ration, pour le calcul du quota quotidien"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "genere",
        "echoue"
      ],
      "default": "en_attente",
      "description": "Statut de la g\u00e9n\u00e9ration"
    },
    "credits_used": {
      "type": "number",
      "default": 0,
      "description": "Obsol\u00e8te (syst\u00e8me de cr\u00e9dits retir\u00e9) \u2014 conserv\u00e9 pour compatibilit\u00e9"
    },
    "duration": {
      "type": "number",
      "default": 6,
      "description": "Dur\u00e9e de la vid\u00e9o en secondes"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16"
      ],
      "default": "16:9",
      "description": "Format de la vid\u00e9o"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}