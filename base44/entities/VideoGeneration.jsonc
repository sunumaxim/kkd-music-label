{
  "name": "VideoGeneration",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur ayant g\u00e9n\u00e9r\u00e9 la vid\u00e9o"
    },
    "prompt": {
      "type": "string",
      "description": "Action souhait\u00e9e par l'utilisateur (texte libre)"
    },
    "image_url": {
      "type": "string",
      "description": "Image source (file_uri priv\u00e9 upload\u00e9 par l'utilisateur)"
    },
    "image_description": {
      "type": "string",
      "description": "Description visuelle de l'image g\u00e9n\u00e9r\u00e9e par l'IA"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la vid\u00e9o anim\u00e9e g\u00e9n\u00e9r\u00e9e"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "genere",
        "echoue"
      ],
      "default": "en_attente",
      "description": "Statut de la g\u00e9n\u00e9ration"
    },
    "credits_used": {
      "type": "number",
      "default": 1,
      "description": "Cr\u00e9dits consomm\u00e9s pour cette g\u00e9n\u00e9ration"
    },
    "duration": {
      "type": "number",
      "default": 6,
      "description": "Dur\u00e9e de la vid\u00e9o en secondes"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16"
      ],
      "default": "16:9",
      "description": "Format de la vid\u00e9o"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}