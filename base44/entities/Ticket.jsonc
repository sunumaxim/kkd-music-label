{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement"
    },
    "event_title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "event_image_url": {
      "type": "string",
      "description": "Affiche de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9, pour le QR/le billet)"
    },
    "artist_name": {
      "type": "string",
      "description": "Artiste li\u00e9 (d\u00e9normalis\u00e9)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (d\u00e9normalis\u00e9)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Gestionnaires d'acc\u00e8s (d\u00e9normalis\u00e9)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email de l'acheteur"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nom de l'acheteur"
    },
    "buyer_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone de l'acheteur"
    },
    "ticket_number": {
      "type": "string",
      "description": "Num\u00e9ro unique g\u00e9n\u00e9r\u00e9 apr\u00e8s validation (format KKD...SM)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Montant pay\u00e9 en FCFA"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) d\u00e9normalis\u00e9e"
    },
    "wave_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence de transaction Wave"
    },
    "proof_file_url": {
      "type": "string",
      "description": "Capture du re\u00e7u (facultatif)"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "annule"
      ],
      "default": "en_attente",
      "description": "Statut de validation admin"
    },
    "validated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Entr\u00e9e valid\u00e9e le jour J"
    },
    "checked_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date du check-in"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Email de la personne ayant valid\u00e9 l'entr\u00e9e"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes admin"
    }
  },
  "required": [
    "event_id",
    "buyer_email",
    "wave_reference"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_email": "{{user.email}}"
        },
        {
          "data.managers": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}