{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement"
    },
    "event_title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "event_image_url": {
      "type": "string",
      "description": "Affiche de l'\u00e9v\u00e9nement (d\u00e9normalis\u00e9)"
    },
    "artist_name": {
      "type": "string",
      "description": "Artiste li\u00e9 (d\u00e9normalis\u00e9)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (d\u00e9normalis\u00e9)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contr\u00f4leurs d'acc\u00e8s autoris\u00e9s (d\u00e9normalis\u00e9)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email de l'acheteur"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nom de l'acheteur"
    },
    "buyer_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone de l'acheteur"
    },
    "ticket_number": {
      "type": "string",
      "description": "Num\u00e9ro unique g\u00e9n\u00e9r\u00e9 apr\u00e8s validation (format KKD...SM)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Montant pay\u00e9 en FCFA"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) d\u00e9normalis\u00e9e"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wave",
        "square"
      ],
      "default": "wave",
      "description": "Moyen de paiement"
    },
    "wave_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence de transaction Wave"
    },
    "square_order_ref": {
      "type": "string",
      "description": "ID du payment link Square"
    },
    "proof_file_url": {
      "type": "string",
      "description": "Capture du re\u00e7u (facultatif)"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "annule"
      ],
      "default": "en_attente",
      "description": "Statut de validation admin"
    },
    "validated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Actuellement \u00e0 l'int\u00e9rieur de l'\u00e9v\u00e9nement"
    },
    "checked_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de la derni\u00e8re entr\u00e9e"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Email du contr\u00f4leur ayant valid\u00e9 l'entr\u00e9e"
    },
    "checked_out": {
      "type": "boolean",
      "default": false,
      "description": "A quitt\u00e9 l'\u00e9v\u00e9nement"
    },
    "checked_out_date": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de la derni\u00e8re sortie"
    },
    "checked_out_by": {
      "type": "string",
      "description": "Email du contr\u00f4leur ayant valid\u00e9 la sortie"
    },
    "entry_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total d'entr\u00e9es (inclut les r\u00e9-entr\u00e9es)"
    },
    "exit_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de sorties"
    },
    "access_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "entry",
              "exit"
            ],
            "description": "Type de mouvement"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Horodatage"
          },
          "by": {
            "type": "string",
            "description": "Email du contr\u00f4leur"
          }
        }
      },
      "default": [],
      "description": "Historique complet des entr\u00e9es/sorties"
    },
    "description": {
      "type": "string",
      "description": "Description",
      "maxLength": 1000
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes admin"
    }
  },
  "required": [
    "event_id",
    "buyer_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.organizer_email": "{{user.email}}"
        },
        {
          "data.managers": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}