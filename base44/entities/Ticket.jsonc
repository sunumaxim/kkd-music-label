{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID de l'événement"
    },
    "event_title": {
      "type": "string",
      "description": "Titre de l'événement (dénormalisé)"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de l'événement (dénormalisé)"
    },
    "event_image_url": {
      "type": "string",
      "description": "Affiche de l'événement (dénormalisé)"
    },
    "artist_name": {
      "type": "string",
      "description": "Artiste lié (dénormalisé)"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email de l'organisateur (dénormalisé)"
    },
    "managers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contrôleurs d'accès autorisés (dénormalisé)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email de l'acheteur (optionnel — si fourni, le billet est visible dans 'Mes Billets' après connexion)"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nom de l'acheteur"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Téléphone de l'acheteur"
    },
    "buyer_location": {
      "type": "string",
      "description": "Ville ou village de l'acheteur"
    },
    "ticket_number": {
      "type": "string",
      "description": "Numéro unique généré après validation (format KKD...SM)"
    },
    "security_hash": {
      "type": "string",
      "description": "Hash de sécurité cryptographique inclus dans le QR code pour empêcher la falsification"
    },
    "batch_id": {
      "type": "string",
      "description": "Identifiant du lot de génération automatique (si billet créé en lot)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Montant payé en FCFA"
    },
    "commission_pct": {
      "type": "number",
      "default": 10,
      "description": "Commission KKD (%) dénormalisée"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wave",
        "square"
      ],
      "default": "wave",
      "description": "Moyen de paiement"
    },
    "wave_reference": {
      "type": "string",
      "description": "Référence de transaction Wave"
    },
    "square_order_ref": {
      "type": "string",
      "description": "ID du payment link Square"
    },
    "proof_file_url": {
      "type": "string",
      "description": "Capture du reçu (facultatif)"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "annule"
      ],
      "default": "en_attente",
      "description": "Statut de validation admin"
    },
    "validated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Actuellement à l'intérieur de l'événement"
    },
    "checked_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de la dernière entrée"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Email du contrôleur ayant validé l'entrée"
    },
    "checked_out": {
      "type": "boolean",
      "default": false,
      "description": "A quitté l'événement"
    },
    "checked_out_date": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de la dernière sortie"
    },
    "checked_out_by": {
      "type": "string",
      "description": "Email du contrôleur ayant validé la sortie"
    },
    "entry_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total d'entrées (inclut les ré-entrées)"
    },
    "exit_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de sorties"
    },
    "access_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "entry",
              "exit"
            ],
            "description": "Type de mouvement"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Horodatage"
          },
          "by": {
            "type": "string",
            "description": "Email du contrôleur"
          }
        }
      },
      "default": [],
      "description": "Historique complet des entrées/sorties"
    },
    "description": {
      "type": "string",
      "description": "Description",
      "maxLength": 1000
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes admin"
    },
    "ticket_category": {
      "type": "string",
      "description": "Catégorie du billet (Prévente, Porte, VIP...)"
    },
    "ticket_theme": {
      "type": "string",
      "description": "Thème de design du billet (dénormalisé)"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.organizer_email": "{{user.email}}"
        },
        {
          "data.managers": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}