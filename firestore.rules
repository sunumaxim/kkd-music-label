rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'storesmaxim@gmail.com' ||
        request.auth.token.email == 'admin@kkdmusic.com'
      );
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isUserSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isSignedIn() && (
        (resource.data.user_id != null && resource.data.user_id == request.auth.uid) ||
        (request.auth.token.email != null && resource.data.user_email != null && resource.data.user_email == request.auth.token.email) ||
        (request.auth.token.phone_number != null && resource.data.phone != null && resource.data.phone == request.auth.token.phone_number)
      );
    }

    // 1. Profils Utilisateurs (Lecture publique pour fiches/profils, modification sécurisée sans élévation de privilège)
    match /users/{userId} {
      // Les documents utilisateurs peuvent contenir des emails et des rôles : pas de lecture publique.
      allow read: if isAdmin() || isUserSelf(userId);
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Empêcher l'élévation arbitraire de rôle vers 'admin' par un non-admin
      allow update: if isAdmin() || (
        isUserSelf(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Sorties Musicales (Catalogue public, modification admin ou incrément d'écoute)
    match /releases/{releaseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Autoriser uniquement une incrémentation unitaire du compteur, jamais une valeur arbitraire.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays_count', 'updated_at']) &&
        request.resource.data.plays_count is number &&
        resource.data.plays_count is number &&
        request.resource.data.plays_count == resource.data.plays_count + 1
      );
    }

    // 3. Artistes (Catalogue public)
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Événements & Concerts (Public)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Billets (Sécurisés)
    match /tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.buyer_uid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.buyer_email == request.auth.token.email)
      ));
      // Les acheteurs ne peuvent créer que leurs propres billets en attente, jamais des billets validés.
      allow create: if isSignedIn() &&
        request.resource.data.buyer_email == request.auth.token.email &&
        request.resource.data.status == 'en_attente' &&
        !request.resource.data.keys().hasAny(['ticket_number', 'security_hash', 'validated_date']);
      allow update, delete: if isAdmin();
    }

    // 6. Licences & Contrats Officiels
    match /musicLicenses/{licenseId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.grantee_uid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.grantee_email == request.auth.token.email)
      ));
      allow write: if isAdmin();
    }

    // 7. Actualités & Presse (Public)
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Vidéos & Clips (Public)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Achats & Transactions
    match /purchases/{purchaseId} {
      allow read: if isAdmin() || isResourceOwner();
      // Seul le backend / un administrateur peut créer un achat payé.
      allow update, delete: if isAdmin();
    }

    // 10. Demandes d'accès artiste
    match /artistAccessRequests/{requestId} {
      allow read: if isAdmin() || isResourceOwner();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 11. Notifications (Inscription, Validation, Modification, Alertes système)
    match /notifications/{notificationId} {
      allow read: if isAdmin() || isResourceOwner() || (resource.data.user_email == 'all');
      allow create: if isSignedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.user_email == request.auth.token.email ||
        (isAdmin() && request.resource.data.user_email == 'all')
      );
      allow update: if isAdmin() || isResourceOwner();
      allow delete: if isAdmin();
    }

    // 12. Playlists des utilisateurs
    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isResourceOwner();
    }

    // 13. Studios & Régies
    match /studios/{studioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Promotions & Bannières
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promoBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. Campagnes d'Emails et Mailings (Admin uniquement)
    match /mailings/{mailingId} {
      allow read, write: if isAdmin();
    }

    // 16. Projets Vidéos (TikTok / Reels / YouTube)
    match /videoProjects/{projectId} {
      // Les projets générés peuvent contenir des données privées de l'utilisateur.
      allow read: if isAdmin() || isResourceOwner();
      allow create: if isSignedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.user_email == request.auth.token.email
      );
      allow update, delete: if isAdmin() || isResourceOwner();
    }

    // 17. Transactions de Crédits & Abonnements
    match /creditTransactions/{txId} {
      allow read: if isAdmin() || isResourceOwner();
      // Les mouvements de crédits doivent être créés par le backend / un administrateur.
      allow update, delete: if isAdmin();
    }

    // 18. Audit & Sécurité
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Les documents de test ne doivent jamais être accessibles publiquement en production.
    match /test/{docId} {
      allow read, write: if false;
    }

    // Sécurité par défaut (Refus strict de tout accès non spécifié)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
